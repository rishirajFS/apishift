aximum": 10080, "minimum": 1, "type": "integer"}}, "required": ["event_id", "minutes_before"], "type": "object"}}, "type": "function"}, {"function": {"description": "Get the current documentation for an API endpoint: parameters, formats and return shape. Call with no arguments to list all endpoints.", "name": "get_api_docs", "parameters": {"additionalProperties": false, "properties": {"endpoint": {"description": "Endpoint name, e.g. 'create_event'.", "type": "string"}}, "required": [], "type": "object"}}, "type": "function"}], "turns": 6}
